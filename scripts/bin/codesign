#!/usr/bin/env bash
# Nested-code codesign wrapper for Tauri macOS builds.
#
# Tauri's macOS bundler copies every [[bin]] into Contents/MacOS, then signs
# them in manifest order — main binary first. codesign treats that file as the
# bundle executable once Info.plist is in place, and every other Mach-O in
# the same directory is nested code that must already be signed. After lipo
# those helpers have no signature, so the main-binary sign dies with
# `code object is not signed at all / In subcomponent: …/<helper>`.
#
# `scripts/tauri.mjs` puts this directory first on PATH for darwin builds, so
# this wrapper runs instead of /usr/bin/codesign. It signs every sibling that
# Cargo.toml declares, with the same identity and flags Tauri passed, then
# the invocation Tauri actually asked for. The helper list is derived, never
# written down — the same stale-list failure the lipo shim already closed.
set -euo pipefail

self_dir=$(cd "$(dirname "$0")" && pwd -P)
manifest="$self_dir/../../src-tauri/Cargo.toml"
tauri_conf="$self_dir/../../src-tauri/tauri.conf.json"

REAL_CODESIGN="${GITPULSE_REAL_CODESIGN:-}"
if [ -z "$REAL_CODESIGN" ]; then
  for candidate in /usr/bin/codesign; do
    if [ -x "$candidate" ]; then
      cand_real=$(cd "$(dirname "$candidate")" && pwd -P)/$(basename "$candidate")
      if [ "$cand_real" != "$self_dir/$(basename "$0")" ]; then
        REAL_CODESIGN="$candidate"
        break
      fi
    fi
  done
fi

if [ -z "$REAL_CODESIGN" ]; then
  echo "codesign wrapper error: could not locate system codesign executable" >&2
  exit 1
fi

declared_binaries() {
  awk '
    /^\[\[bin\]\]/ { in_bin = 1; next }
    /^\[/          { in_bin = 0 }
    in_bin && /^name[[:space:]]*=/ {
      line = $0
      sub(/^name[[:space:]]*=[[:space:]]*"/, "", line)
      sub(/".*$/, "", line)
      print line
      in_bin = 0
    }
  ' "$manifest"
}

main_binary_name() {
  awk '
    /"mainBinaryName"/ {
      line = $0
      sub(/^.*"mainBinaryName"[[:space:]]*:[[:space:]]*"/, "", line)
      sub(/".*$/, "", line)
      print line
      exit
    }
  ' "$tauri_conf"
}

is_sign=0
for arg in "$@"; do
  case "$arg" in
    -s|--sign) is_sign=1 ;;
  esac
done

# Display, verify, and anything else that is not a sign must pass through.
# Pre-signing helpers on `codesign -d` would mutate binaries a query asked
# only to inspect.
if [ "$is_sign" -eq 0 ]; then
  exec "$REAL_CODESIGN" "$@"
fi

[ $# -ge 1 ] || exec "$REAL_CODESIGN" "$@"

target="${!#}"
main_binary=""
if [ -f "$tauri_conf" ]; then
  main_binary=$(main_binary_name)
fi
[ -n "$main_binary" ] || exec "$REAL_CODESIGN" "$@"

# Only the main executable is the nested-code parent. Signing a helper
# must not walk back to the main binary: that is the order that fails.
if [ "$(basename "$target")" != "$main_binary" ]; then
  exec "$REAL_CODESIGN" "$@"
fi

parent_dir=$(dirname "$target")
[ -f "$manifest" ] || exec "$REAL_CODESIGN" "$@"

status=0
while read -r helper; do
  [ "$helper" = "$main_binary" ] && continue
  helper_path="$parent_dir/$helper"
  [ -f "$helper_path" ] || continue

  helper_args=("$@")
  last=$((${#helper_args[@]} - 1))
  helper_args[$last]="$helper_path"

  echo "[gitpulse-codesign] nested helper first: $helper_path" >&2
  if ! "$REAL_CODESIGN" "${helper_args[@]}"; then
    echo "[gitpulse-codesign] failed to sign nested helper $helper_path" >&2
    status=1
  fi
done < <(declared_binaries)

[ "$status" -eq 0 ] || exit "$status"
exec "$REAL_CODESIGN" "$@"

{
  "name": "@gitpulse/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript GitPulse control-plane domain logic, diff engine, and transport-injected client (zero Svelte/DOM/Tauri imports)",
  "license": "MIT OR Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/types.ts",
    "./agents": "./src/agents/plane.ts",
    "./capabilities": "./src/agents/capabilities.ts",
    "./diff": "./src/diff/wordDiff.ts",
    "./client": "./src/client/ControlPlaneClient.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

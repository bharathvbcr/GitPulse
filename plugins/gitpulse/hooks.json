{
  "gitpulse": {
    "SessionStart": [
      {
        "type": "command",
        "command": "gitpulse-hook --host=agy session-brief",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(edit_file|write_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook --host=agy collision-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^run_command$",
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook --host=agy command-gate",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook --host=agy notify tool_finished",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "gitpulse-hook --host=agy notify prompt_submitted",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "gitpulse-hook --host=agy notify turn_finished",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "gitpulse-hook --host=agy deliver",
        "timeout": 5
      }
    ]
  }
}

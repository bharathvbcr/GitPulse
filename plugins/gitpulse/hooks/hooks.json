{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook collision-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook command-gate",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify permission_request",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify tool_finished",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify tool_finished",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify prompt_submitted",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify turn_finished",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify error",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook session-brief",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify session_ended",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify permission_prompt",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify idle_prompt",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify agent_needs_input",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify agent_completed",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify elicitation_dialog",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "gitpulse-hook notify elicitation_url_dialog",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

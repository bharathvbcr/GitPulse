{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Waylode",
  "version": "0.2.0-beta.1",
  "mainBinaryName": "waylode",
  "identifier": "dev.vbcr.waylode",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Waylode",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 14
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "object-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:5173 http://127.0.0.1:5173",
        "script-src": "'self' http://localhost:5173 http://127.0.0.1:5173",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5173 ws://127.0.0.1:5173",
        "base-uri": "'none'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "wix": {
        "version": "0.2.0.1",
        "upgradeCode": "b6ba8858-9476-58c2-a749-8f985b9a9d0a"
      },
      "nsis": {
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Fast, local-first Git desktop client and code intelligence workspace",
    "longDescription": "Waylode is a high-performance native desktop Git client, code intelligence engine, and task workspace built with Rust (Tauri 2) and Svelte 5.",
    "resources": {
      "../plugins/waylode/": "plugin/"
    },
    "fileAssociations": [
      {
        "ext": [
          "git"
        ],
        "name": "Git Repository",
        "description": "Git repository",
        "role": "Editor",
        "rank": "Alternate",
        "contentTypes": [
          "public.folder"
        ]
      }
    ]
  }
}

{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitPulse",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "tabbingIdentifier": "com.gitpulse.desktop",
        "trafficLightPosition": {
          "x": 16,
          "y": 14
        },
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI --enable-gpu-rasterization --enable-zero-copy --ignore-gpu-blocklist --enable-features=CanvasOopRasterization",
        "transparent": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground"
          ],
          "state": "followsWindowActiveState",
          "radius": 12
        }
      }
    ]
  }
}

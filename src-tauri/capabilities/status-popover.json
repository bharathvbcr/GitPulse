{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "status-popover",
  "description": "Local status view: receive workspace presentation updates, call the three status commands, and read the system's Reduce Transparency setting.",
  "windows": [
    "status-popover"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-cmd-get-accessibility-display",
    "allow-cmd-get-status-state",
    "allow-cmd-status-action",
    "allow-cmd-resize-status"
  ]
}

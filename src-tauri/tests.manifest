<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest for this crate's TEST binaries and its Windows cdylib.

  Without it, suites that reach muda's and wry's window code died at load
  with STATUS_ENTRYPOINT_NOT_FOUND before main ran. Declaring the comctl32
  version 6 dependency binds the side-by-side assembly instead of the 5.82
  copy in System32. The library test harness loads the cdylib, so it needs
  the same manifest as the integration binaries.

  The application binary gets an equivalent manifest from tauri_build. See
  build.rs for what was and was not verified about the exact failing import.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>

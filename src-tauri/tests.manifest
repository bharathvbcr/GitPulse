<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest for this crate's Windows MSVC artifacts.

  Without it, suites that reach muda's and wry's window code died at load
  with STATUS_ENTRYPOINT_NOT_FOUND before main ran. Declaring the comctl32
  version 6 dependency binds the side-by-side assembly instead of the 5.82
  copy in System32. Catch-all rustc-link-arg embeds this on bins, tests,
  the cdylib, and the lib unit-test harness. tauri-winres keeps icon and
  version on named bins and must not also ship RT_MANIFEST.

  See build.rs for what was and was not verified about the exact failing import.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>

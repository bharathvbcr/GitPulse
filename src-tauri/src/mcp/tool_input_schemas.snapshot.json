  "gitpulse_add_task": {
    "additionalProperties": false,
    "properties": {
      "acceptance_criteria": {
        "description": "Definition of done, one item each",
        "items": {
          "maxLength": 4096,
          "type": "string"
        },
        "maxItems": 128,
        "type": "array"
      },
      "description": {
        "description": "Background and problem statement (Markdown)",
        "maxLength": 65536,
        "type": "string"
      },
      "due": {
        "description": "Due date as YYYY-MM-DD, or Unix seconds",
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
      },
      "kind": {
        "description": "Type, e.g. feature (default), bug, refactor, chore, spike",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "labels": {
        "description": "Labels",
        "items": {
          "maxLength": 128,
          "type": "string"
        },
        "maxItems": 64,
        "type": "array"
      },
      "logs": {
        "description": "Raw logs or traces kept verbatim as evidence (up to 256 KiB)",
        "maxLength": 262144,
        "type": "string"
      },
      "overwrite": {
        "description": "Replace the content of the task already filed under this task_id, or of the board task whose item_id is task_id (default false). Its column position and links are kept. This is how related work is folded into an existing task: send its current content plus yours.",
        "type": "boolean"
      },
      "owner": {
        "description": "Assignee, e.g. '@alice'",
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "planned_files": {
        "description": "Files the work is expected to touch; kept as a section of the description",
        "items": {
          "maxLength": 4096,
          "type": "string"
        },
        "maxItems": 256,
        "type": "array"
      },
      "priority": {
        "description": "Priority: 0 (urgent), 1 (high), 2 (normal, default), 3 (low)",
        "maximum": 3,
        "minimum": 0,
        "type": "integer"
      },
      "repo_path": {
        "description": "Absolute path to a git repository",
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "repositories": {
        "description": "Other related repository names; kept as a section of the description",
        "items": {
          "maxLength": 300,
          "type": "string"
        },
        "maxItems": 64,
        "type": "array"
      },
      "reviewed_related": {
        "description": "item_ids of the open tasks a related_tasks_exist refusal listed, once you have read them and this task is genuinely separate work",
        "items": {
          "maxLength": 128,
          "type": "string"
        },
        "maxItems": 500,
        "type": "array"
      },
      "severity": {
        "description": "Severity (default none)",
        "enum": [
          "none",
          "low",
          "medium",
          "high",
          "critical"
        ],
        "maxLength": 32,
        "type": "string"
      },
      "status": {
        "description": "Board column (default inbox)",
        "enum": [
          "inbox",
          "backlog",
          "ready",
          "in_progress",
          "review",
          "done"
        ],
        "maxLength": 32,
        "type": "string"
      },
      "task_id": {
        "description": "Stable key for this task (letters, digits, '-', '_', '.'), e.g. 'gp-auth-flow'. Defaults to 'gp-' plus the title's slug.",
        "maxLength": 96,
        "minLength": 1,
        "type": "string"
      },
      "title": {
        "description": "Task title: one line, at most 300 characters",
        "maxLength": 1200,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "repo_path",
      "title"
    ],
    "type": "object"
  },

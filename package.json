{
  "name": "gitpulse",
  "version": "0.0.3",
  "private": true,
  "license": "MIT",
  "description": "High-performance native Git desktop client built with Rust (Tauri 2) and Svelte 5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharathvbcr/GitPulse.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/vite-dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json --noEmit",
    "check:ipc": "node scripts/check-ipc-contract.mjs",
    "check:types": "node scripts/check-coverage-types.mjs",
    "check:release": "node scripts/check-release-version.mjs",
    "check:coverage": "node scripts/check-coverage-floor.mjs",
    "ci:local": "npm run check:ipc && npm run check:types && npm run check:release && npm run check && npm run coverage && npm run build && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo llvm-cov --manifest-path src-tauri/Cargo.toml --workspace --lcov --output-path lcov.info && npm run check:coverage",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-svelte": "^0.475.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}

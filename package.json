{
  "name": "gitpulse",
  "version": "0.2.0-beta.1",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "description": "Fast, local-first Git desktop client, code intelligence suite, and task workspace built with Rust (Tauri 2) and Svelte 5",
  "keywords": [
    "git",
    "git-client",
    "git-gui",
    "tauri",
    "tauri-v2",
    "rust",
    "svelte",
    "svelte-5",
    "local-first",
    "code-intelligence",
    "commit-graph",
    "merge-conflicts",
    "developer-tools",
    "devtools",
    "desktop-app",
    "mcp",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharathvbcr/GitPulse.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "node scripts/vite-dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && bun run typecheck",
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.node.json --noEmit",
    "design:lint": "node scripts/design-lint.mjs",
    "design:gate": "node scripts/design-lint.mjs --strict",
    "check:ipc": "node scripts/check-ipc-contract.mjs",
    "check:types": "node scripts/check-coverage-types.mjs",
    "check:release": "node scripts/check-release-version.mjs",
    "check:coverage": "node scripts/check-coverage-floor.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:vendor-schema": "node scripts/check-vendor-schema.mjs",
    "check:schema-parity": "node scripts/check-schema-parity.mjs",
    "check:fixture-authors": "bash .githooks/lib/fixture-commits.sh",
    "mcp:install": "cargo install --path src-tauri --bin gitpulse-mcp --bin gitpulse-hook --locked --force && node scripts/record-install.mjs",
    "mcp:doctor": "node scripts/check-mcp-install.mjs",
    "gusset:check": "node scripts/gusset-check.mjs",
    "check:ptyd-release": "node scripts/check-ptyd-release.mjs",
    "vendor": "node scripts/vendor-crates.mjs",
    "vendor:check": "node scripts/vendor-crates.mjs --check",
    "check:vendor-edits": "node scripts/vendor-crates.mjs --check --allow-drift",
    "release:notes": "node scripts/release-notes.mjs",
    "release:ready": "node scripts/release-state.mjs ready",
    "ci:local": "node scripts/ci-local.mjs",
    "test": "vitest run",
    "test:tz": "node scripts/test-timezones.mjs",
    "coverage": "vitest run --coverage",
    "tauri": "node scripts/tauri.mjs",
    "test:browser": "node scripts/browser-regressions.mjs",
    "test:browser:all": "node scripts/browser-regressions.mjs --all",
    "test:coverage-ui": "node scripts/browser-regressions.mjs --harness coverage",
    "test:webkit": "node scripts/browser-regressions.mjs --webkit",
    "test:webkit:all": "node scripts/browser-regressions.mjs --webkit --all",
    "test:native": "node scripts/browser-regressions.mjs --native",
    "test:native:all": "node scripts/browser-regressions.mjs --native --all",
    "test:e2e:driver": "node scripts/e2e-driver-smoke.mjs",
    "test:linux:podman": "node scripts/linux-podman.mjs",
    "check:windows:cross": "node scripts/check-windows-cross.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.77.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@xterm/addon-fit": "0.12.0-beta.335",
    "@xterm/addon-search": "0.17.0-beta.333",
    "@xterm/addon-serialize": "0.15.0-beta.333",
    "@xterm/addon-unicode11": "0.10.0-beta.333",
    "@xterm/addon-webgl": "0.20.0-beta.332",
    "@xterm/xterm": "6.1.0-beta.339"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "svelte": "5.58.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}

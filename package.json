{
  "name": "gitpulse",
  "version": "0.0.7",
  "private": true,
  "license": "MIT",
  "description": "High-performance native Git desktop client built with Rust (Tauri 2) and Svelte 5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharathvbcr/GitPulse.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/vite-dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && npm run typecheck",
    "typecheck": "tsgo -p tsconfig.node.json --noEmit",
    "check:ipc": "node scripts/check-ipc-contract.mjs",
    "check:types": "node scripts/check-coverage-types.mjs",
    "check:release": "node scripts/check-release-version.mjs",
    "check:coverage": "node scripts/check-coverage-floor.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:vendor-schema": "node scripts/check-vendor-schema.mjs",
    "mcp:install": "cargo install --path src-tauri --bin gitpulse-mcp --locked --force",
    "mcp:doctor": "node scripts/check-mcp-install.mjs",
    "vendor": "node scripts/vendor-crates.mjs",
    "vendor:check": "node scripts/vendor-crates.mjs --check",
    "release:notes": "node scripts/release-notes.mjs",
    "ci:local": "node scripts/vendor-crates.mjs --check --allow-drift && npm run check:vendor-schema && npm run check:ipc && npm run check:types && npm run check:release && npm run check:workflows && npm run check && npm run coverage && npm run build && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo llvm-cov --manifest-path src-tauri/Cargo.toml --workspace --lcov --output-path lcov.info && npm run check:coverage",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.42.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}

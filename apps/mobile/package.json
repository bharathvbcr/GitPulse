{
  "name": "@gitpulse/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "GitPulse Unified Control Plane mobile companion (iOS + Android, Expo New Architecture + Rust UniFFI)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
